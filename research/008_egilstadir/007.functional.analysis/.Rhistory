#
# this step takes surprisingly long time
tic()
ck = compareCluster(geneLists,
fun="enrichPathway",
pvalueCutoff=0.05)
toc()
# this long step takes 42 seconds on an M1 chip
p1 = dotplot(ck, size='count', showCategory=5, font.size=8)
