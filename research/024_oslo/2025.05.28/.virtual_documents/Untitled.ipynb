df = pandas.read_csv('my_dataframe.tsv', sep='\t')


conditions = list(set(df['Group']))
conditions = [conditions[index] for index in [2, 0, 3, 1]]
print(conditions)


boxplot_values = []
for condition in conditions:
    print(condition)
    sub = df[df['Group'] == condition]
    print(sub)
    wells = list(set(sub['Well']))
    print(wells)
    all_medians = []
    for well in wells:
        print(well)
        values = sub[sub['Well'] == well]['OCR']
        print(values)
        median = values.median()
        print(median)
        all_medians.append(median)
    # about to plot
    print(all_medians)
    boxplot_values.append(all_medians)
