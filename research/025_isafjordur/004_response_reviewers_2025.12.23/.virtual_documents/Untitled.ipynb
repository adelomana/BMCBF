# define ns bars
def add_ns(ax, x1, x2, y, h=0.02, text="ns"):
    ax.plot([x1, x1, x2, x2], [y, y+h, y+h, y], lw=2, c="k")
    ax.text((x1+x2)/2, y+h, text, ha="center", va="bottom", fontsize=14)
add_ns(ax, 1, 2, y=0)
add_ns(ax, 3, 4, y=0)


