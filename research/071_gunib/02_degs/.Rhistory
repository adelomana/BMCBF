knitr::opts_chunk$set(echo = TRUE, comment = "#>")
data <- read.table("LAK101_assignment01_awh1.tsv", header = TRUE, sep = "\t")
knitr::opts_chunk$set(echo = TRUE, comment = "#>")
data <- read.table("LAK101_assignment01_awh1.tsv", header = TRUE, sep = "\t")
data$sex              <- factor(data$sex)
data$blood_type       <- factor(data$blood_type)
data$hypertension     <- factor(data$hypertension)
data$smoking_status   <- factor(data$smoking_status,
levels = c("Never", "Former", "Current"),
ordered = TRUE)
data$disease_severity <- factor(data$disease_severity,
levels = c("Mild", "Moderate", "Severe"),
ordered = TRUE)
tab_blue   <- "#4E79A7"
tab_orange <- "#F28E2B"
tab_red    <- "#E15759"
tab_teal   <- "#76B7B2"
p_severe <- mean(data$disease_severity == "Severe")
cat("P(Severe):", round(p_severe, 3), "\n")
cat("Percentage:", round(p_severe * 100, 1), "%\n")
str(data[, c("sex", "disease_severity", "hospital_days", "systolic_bp")])
cat("Mean systolic BP:", round(mean(data$systolic_bp), 1), "mmHg\n")
cat("SD systolic BP:  ", round(sd(data$systolic_bp),   1), "mmHg\n")
cat("Median:          ", round(median(data$systolic_bp), 1), "mmHg\n")
cat("Mean CRP:  ", round(mean(data$crp_mgL), 1),   "mg/L\n")
cat("Median CRP:", round(median(data$crp_mgL), 1), "mg/L\n")
cat("SD CRP:    ", round(sd(data$crp_mgL), 1),     "mg/L\n")
cat("IQR CRP:   ", round(IQR(data$crp_mgL), 1),    "mg/L\n")
mu  <- mean(data$systolic_bp)
sd_ <- sd(data$systolic_bp)
pct_1sd <- mean(abs(data$systolic_bp - mu) <= sd_) * 100
cat("Within 1 SD:", round(pct_1sd, 1), "% (theory: 68%)\n")
p_above_150 <- mean(data$systolic_bp > 150)
cat("P(systolic BP > 150):", round(p_above_150, 3), "\n")
cat("Percentage:", round(p_above_150 * 100, 1), "%\n")
hist(data$systolic_bp,
main   = "Systolic BP — patients above 150 mmHg",
xlab   = "Systolic BP (mmHg)", ylab = "Count",
col    = tab_blue, border = "white", breaks = 20)
abline(v = 150, col = tab_red, lwd = 2, lty = 2)
legend("topright", legend = "150 mmHg threshold",
col = tab_red, lty = 2, lwd = 2, bty = "n")
mu_crp  <- mean(data$crp_mgL)
sd_crp  <- sd(data$crp_mgL)
crp_val <- 30
z <- (crp_val - mu_crp) / sd_crp
cat("Mean CRP:", round(mu_crp, 1), "| SD:", round(sd_crp, 1), "\n")
cat("Z-score for CRP = 30 mg/L:", round(z, 2), "\n")
pct_below <- pnorm(z) * 100
cat("This patient is above", round(pct_below, 1),
"% of the cohort (assuming normality)\n")
# Empirical 90th percentile
p90_empirical <- quantile(data$systolic_bp, 0.90)
cat("Empirical 90th percentile:", round(p90_empirical, 1), "mmHg\n")
# Theoretical 90th percentile from normal model
mu  <- mean(data$systolic_bp)
sd_ <- sd(data$systolic_bp)
p90_theoretical <- qnorm(0.90, mean = mu, sd = sd_)
cat("Theoretical 90th percentile:", round(p90_theoretical, 1), "mmHg\n")
cat("Difference:", round(abs(p90_empirical - p90_theoretical), 1), "mmHg\n")
hist(data$systolic_bp,
main = "Systolic BP — histogram",
xlab = "Systolic BP (mmHg)", ylab = "Count",
col = tab_blue, border = "white", breaks = 20)
mu_crp  <- mean(data$crp_mgL)
sd_crp  <- sd(data$crp_mgL)
# Theoretical probability under normal model
p_theory <- pnorm(20, mean = mu_crp, sd = sd_crp, lower.tail = FALSE)
cat("P(CRP > 20) — normal model:", round(p_theory, 4), "\n")
# Empirical probability from data
p_empirical <- mean(data$crp_mgL > 20)
cat("P(CRP > 20) — empirical:   ", round(p_empirical, 4), "\n")
cat("Difference:", round(abs(p_theory - p_empirical), 4), "\n")
sessionInfo()
