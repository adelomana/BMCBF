knitr::opts_chunk$set(echo = TRUE, comment = "#>")
data <- read.table("LAK101_week01_data.tsv", header = TRUE, sep = "\t")
knitr::opts_chunk$set(echo = TRUE, comment = "#>")
data <- read.table("LAK101_week01_data.tsv", header = TRUE, sep = "\t")
data$sex              <- factor(data$sex)
data$blood_type       <- factor(data$blood_type)
data$hypertension     <- factor(data$hypertension)
data$smoking_status   <- factor(data$smoking_status,
levels = c("Never", "Former", "Current"),
ordered = TRUE)
data$disease_severity <- factor(data$disease_severity,
levels = c("Mild", "Moderate", "Severe"),
ordered = TRUE)
tab_blue   <- "#4E79A7"
tab_orange <- "#F28E2B"
tab_red    <- "#E15759"
tab_teal   <- "#76B7B2"
tab_green  <- "#59A14F"
# Absolute frequencies
table(data$disease_severity)
# Relative frequencies = empirical probabilities
round(prop.table(table(data$disease_severity)), 3)
# What is the probability of randomly selecting a current smoker?
round(prop.table(table(data$smoking_status)), 3)
# P(hypertension AND current smoker)
both <- sum(data$hypertension == "Yes" & data$smoking_status == "Current")
total <- nrow(data)
cat("P(hypertensive AND current smoker):", round(both / total, 3), "\n")
# P(hypertension OR current smoker)
either <- sum(data$hypertension == "Yes" | data$smoking_status == "Current")
cat("P(hypertensive OR current smoker): ", round(either / total, 3), "\n")
sum(prop.table(table(data$disease_severity)))
hist(data$systolic_bp,
main   = "Systolic BP — approximately normal",
xlab   = "Systolic BP (mmHg)", ylab = "Count",
col    = tab_blue, border = "white", breaks = 20)
abline(v = mean(data$systolic_bp),   col = tab_red,    lwd = 2, lty = 1)
abline(v = median(data$systolic_bp), col = tab_orange, lwd = 2, lty = 2)
legend("topright",
legend = c(paste("Mean =",   round(mean(data$systolic_bp),   1)),
paste("Median =", round(median(data$systolic_bp), 1))),
col = c(tab_red, tab_orange), lty = c(1, 2), lwd = 2, bty = "n")
hist(data$crp_mgL,
main   = "CRP — right-skewed",
xlab   = "CRP (mg/L)", ylab = "Count",
col    = tab_orange, border = "white", breaks = 30)
abline(v = mean(data$crp_mgL),   col = tab_red,  lwd = 2, lty = 1)
abline(v = median(data$crp_mgL), col = tab_blue, lwd = 2, lty = 2)
legend("topright",
legend = c(paste("Mean =",   round(mean(data$crp_mgL),   1)),
paste("Median =", round(median(data$crp_mgL), 1))),
col = c(tab_red, tab_blue), lty = c(1, 2), lwd = 2, bty = "n")
qqnorm(data$systolic_bp,
main = "Q-Q plot: Systolic BP",
pch = 16, col = adjustcolor(tab_blue, 0.5))
qqline(data$systolic_bp, col = tab_red, lwd = 2)
qqnorm(data$crp_mgL,
main = "Q-Q plot: CRP",
pch = 16, col = adjustcolor(tab_orange, 0.5))
qqline(data$crp_mgL, col = tab_red, lwd = 2)
x <- seq(90, 170, length.out = 300)
y <- dnorm(x, mean = 130, sd = 15)
plot(x, y, type = "l", lwd = 2, col = tab_blue,
main = "Normal distribution: mean = 130, SD = 15",
xlab = "Systolic BP (mmHg)", ylab = "Density")
abline(v = 130, col = tab_red, lwd = 1.5, lty = 2)
# Assuming systolic BP ~ N(130, 15²):
mu <- 130
sigma <- 15
# P(BP < 115) — below 1 SD
cat("P(BP < 115):", round(pnorm(115, mean = mu, sd = sigma), 4), "\n")
# P(BP > 160) — above 2 SD
cat("P(BP > 160):", round(pnorm(160, mean = mu, sd = sigma,
lower.tail = FALSE), 4), "\n")
# P(115 < BP < 145) — within 1 SD either side
cat("P(115 < BP < 145):", round(pnorm(145, mean = mu, sd = sigma) -
pnorm(115, mean = mu, sd = sigma), 4), "\n")
# What value separates the bottom 5% from the rest?
cat("5th percentile:", round(qnorm(0.05, mean = mu, sd = sigma), 1), "\n")
# What value separates the top 10%?
cat("90th percentile:", round(qnorm(0.90, mean = mu, sd = sigma), 1), "\n")
# The value exceeded by only 2.5% of patients
cat("97.5th percentile:", round(qnorm(0.975, mean = mu, sd = sigma), 1), "\n")
mu_crp    <- mean(data$crp_mgL)
sigma_crp <- sd(data$crp_mgL)
cat("Mean CRP:", round(mu_crp, 1), "mg/L\n")
cat("SD CRP:  ", round(sigma_crp, 1), "mg/L\n")
# Z-score for a patient with CRP = 45 mg/L
crp_patient <- 45
z <- (crp_patient - mu_crp) / sigma_crp
cat("\nPatient CRP:", crp_patient, "mg/L\n")
cat("Z-score:    ", round(z, 2), "\n")
cat("Interpretation: this patient is", round(z, 2),
"SDs above the cohort mean.\n")
# What proportion of the cohort has a lower CRP than this patient?
pct_below <- pnorm(z) * 100
cat("Percentage of cohort below this patient's CRP:",
round(pct_below, 1), "%\n")
data$crp_zscore <- (data$crp_mgL - mu_crp) / sigma_crp
# Who has the most extreme CRP values?
extreme <- data[abs(data$crp_zscore) > 2,
c("patient_id", "crp_mgL", "crp_zscore",
"disease_severity", "smoking_status")]
extreme <- extreme[order(-extreme$crp_zscore), ]
head(extreme, 10)
hist(data$crp_zscore,
main   = "Z-scores of CRP",
xlab   = "Z-score", ylab = "Count",
col    = tab_teal, border = "white", breaks = 30)
abline(v = c(-2, 2), col = tab_red, lwd = 1.5, lty = 2)
legend("topright",
legend = "Z = ±2", col = tab_red, lty = 2, lwd = 1.5, bty = "n")
mu_sbp    <- mean(data$systolic_bp)
sigma_sbp <- sd(data$systolic_bp)
within_1sd <- mean(abs(data$systolic_bp - mu_sbp) <= 1 * sigma_sbp) * 100
within_2sd <- mean(abs(data$systolic_bp - mu_sbp) <= 2 * sigma_sbp) * 100
within_3sd <- mean(abs(data$systolic_bp - mu_sbp) <= 3 * sigma_sbp) * 100
cat("Within 1 SD:", round(within_1sd, 1), "% (theory: 68%)\n")
cat("Within 2 SD:", round(within_2sd, 1), "% (theory: 95%)\n")
cat("Within 3 SD:", round(within_3sd, 1), "% (theory: 99.7%)\n")
# Now check CRP — a skewed variable — as a contrast
mu_c    <- mean(data$crp_mgL)
sigma_c <- sd(data$crp_mgL)
w1 <- mean(abs(data$crp_mgL - mu_c) <= 1 * sigma_c) * 100
w2 <- mean(abs(data$crp_mgL - mu_c) <= 2 * sigma_c) * 100
w3 <- mean(abs(data$crp_mgL - mu_c) <= 3 * sigma_c) * 100
cat("CRP within 1 SD:", round(w1, 1), "% (theory: 68%)\n")
cat("CRP within 2 SD:", round(w2, 1), "% (theory: 95%)\n")
cat("CRP within 3 SD:", round(w3, 1), "% (theory: 99.7%)\n")
sessionInfo()
