


import xenaPython as xena
import pandas as pd

# UCSC public hub
host = "https://toil.xenahubs.net"

# Dataset with gene expression in TPM (e.g., TCGA pan-cancer RNA-seq)
dataset = "TcgaTargetGtex_rsem_gene_tpm"

# Genes and samples of interest
genes = ["TP53", "EGFR", "MYC"]
samples = [
    "TCGA-02-0001-01",  # example TCGA sample
    "TCGA-02-0003-01"
]

# Retrieve TPM expression data
expression = xena.dataset_probe_values(host, dataset, genes, samples)

# Convert to DataFrame
df = pd.DataFrame(expression, index=genes, columns=samples).T
print(df)
