import pandas


%%time
df = pandas.read_csv('r1/output1.sam', skiprows=188758, sep='\t', header=None, on_bad_lines="skip", dtype={12: str})
df.head()
print(df.shape)

# reads that align
aligned = df[df[4] == 255]
print(aligned.shape)

# unique alignments
unique1 = aligned[aligned[11] == 'NH:i:1']
print(unique1.shape)

df.head()


%%time
df = pandas.read_csv('r2/output2.sam', skiprows=188766, sep='\t', header=None, on_bad_lines="skip", dtype={12: str})
df.head()
print(df.shape)

# reads that align
aligned2 = df[df[4] == 255]
print(aligned2.shape)

# # unique alignments
# unique2 = aligned2[aligned[11] == 'NH:i:1']
# print(unique1.shape)

df.head()


%%time

# 100 trials takes circa 3 min: all successes (72)
# 1,000 trials take circa 43 min: 670 successes; 22 failures; 3%
# 10,000 trials takes circa 5 h: 6818 successes; 193 failures; 3%
# 100,000 trials takes circa xxh: 
# total is 1,566,599

successes = 0; failures = 0; trials = 100000

for index, row in unique1.head(trials).iterrows():
    name1 = row[0]
    transcript1 = row[2]
    hit = sum(aligned2[0] == name1)
    if hit == 1:
        transcript2 = aligned2[aligned2[0] == name1][2].to_list()[0]
        if transcript1 == transcript2:
            #print('SUCCESS', name1, transcript1)
            successes = successes + 1
        else:
            print('FAILURE', name1, transcript1, transcript2)
            print(aligned2[aligned2[0] == name1])
            failures = failures + 1

print(trials, successes, failures)



