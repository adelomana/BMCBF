import requests
import csv

# Define the UniProt query
query = 'organism_id:9606 AND keyword:"Cell membrane [KW-1003]"'

# UniProt API endpoint
url = "https://rest.uniprot.org/uniprotkb/search"

# Fields you want to retrieve
fields = "accession,gene_names,protein_name,subcellular_location"

# Request parameters
params = {
    "query": query,
    "fields": fields,
    "format": "tsv",
    "size": 500  # can paginate for more
}

# Send the request
response = requests.get(url, params=params)
response.raise_for_status()

# Save results to a TSV file
output_file = "human_cell_membrane_proteins.tsv"
with open(output_file, "w", newline='', encoding="utf-8") as f:
    f.write(response.text)

print(f"Results saved to {output_file}")

