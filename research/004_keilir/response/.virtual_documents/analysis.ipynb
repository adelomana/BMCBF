from matplotlib_venn import venn2,venn2_circles 
from matplotlib import pyplot as plt 
  
# depict venn diagram 
venn2(subsets = (50, 10, 7), 
      set_labels = ('Group A',  
                    'Group B'), 
      set_colors=("orange", 
                  "blue"),alpha=0.7) 
  
# add outline 
venn2_circles(subsets=(50,10,7))  
plt.show()



