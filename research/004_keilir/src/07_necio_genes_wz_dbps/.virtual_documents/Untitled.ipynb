import pandas, numpy


import matplotlib, matplotlib.pyplot
matplotlib.rcParams.update({'font.size':20, 
                            'font.family':'sans-serif', 
                            'xtick.labelsize':16, 
                            'ytick.labelsize':16, 
                            'figure.figsize':(16*(2/3), 9*(2/3)), 
                            'axes.labelsize':20
                           })



input_file = '/Users/adrian/research/bmcbf/004_keilir/results/06_necio_diff_peaks/results_black/DESeq2_results_all_peaks.black.tsv'


df = pandas.read_csv(input_file, sep='\t')
df


sum((df['padj'] < 0.05))


# get all genes that pass significance
sig = df[(df['padj'] < 0.05) & (df['promoter_genes_s1kb'].notna()) & (numpy.abs(df['log2FoldChange']) >= 1)]
sig


genes = sorted(set(sig["promoter_genes_s1kb"].dropna().str.split(";").explode().str.strip()))
print(len(genes), genes[:10])
'MLANA' in genes



# for each gene, get median log2fc and median p. store in df
x = []; y = []; names = []
for gene in genes:

    #print(gene)

    sub_df = sig[sig["promoter_genes_s1kb"].str.split(";").apply(lambda xs: gene in [x.strip() for x in xs])]


    #print(sub_df)

    fc = numpy.median(sub_df['log2FoldChange'])
    p = numpy.median(-numpy.log10(sub_df['padj']))
    #print(fc, p)
    x.append(fc)
    y.append(p)
    names.append(gene)
    


    


results = pandas.DataFrame({
    "median FE": x,
    "median P": y,
    "gene": names
})
results


top_pos = results.loc[results["median FE"].gt(0)].nsmallest(10, "median P")
top_neg = results.loc[results["median FE"].lt(0)].nsmallest(10, "median P")






# plot volcano
matplotlib.pyplot.scatter(x, y, s=50, c='black', marker='o', alpha=1/10, edgecolors='none')

matplotlib.pyplot.plot([-8, -1], [-numpy.log10(0.05), -numpy.log10(0.05)], lw=2, ls='--', color='red', zorder=0)
matplotlib.pyplot.plot([8, 1], [-numpy.log10(0.05), -numpy.log10(0.05)], lw=2, ls='--', color='red', zorder=0)
matplotlib.pyplot.plot([-1, -1], [-numpy.log10(0.05), 5], lw=2, ls='--', color='red', zorder=0)
matplotlib.pyplot.plot([1, 1], [-numpy.log10(0.05), 5], lw=2, ls='--', color='red', zorder=0)

matplotlib.pyplot.xlabel('Expression difference [Beta estimate]')
matplotlib.pyplot.ylabel('Significance [-log$_{10}$ P]')
matplotlib.pyplot.grid(ls=':', zorder=0)
matplotlib.pyplot.tight_layout()
matplotlib.pyplot.show()



