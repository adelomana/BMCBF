def visualize():
    input_file = working_dir + '/' + path
    try:
        df = pandas.read_csv(input_file, header=None, sep='\t')
        print(df.shape)
        sizes = df[2] - df[1]

        # Compute histogram
        counts, bins = numpy.histogram(sizes, bins=100)
        
        x = numpy.linspace(min(sizes), max(sizes), 500)
        density = scipy.stats.gaussian_kde(sizes)
        bin_width = bins[1] - bins[0]
        kde_scaled = density(x) * len(sizes) * bin_width
        
        matplotlib.pyplot.plot(x, kde_scaled, lw=2, color='black')
        matplotlib.pyplot.plot(bins[:-1], counts, '.', color='black')

        matplotlib.pyplot.title(label)
        matplotlib.pyplot.xlabel("Peak length [log10 bp]")
        matplotlib.pyplot.ylabel("Count")
        matplotlib.pyplot.title("Peak length distribution")
        matplotlib.pyplot.grid(ls=':')
        matplotlib.pyplot.tight_layout()
        matplotlib.pyplot.show()
    except:
        pass
    return None


paths = os.listdir(working_dir)
for path in paths:
    if '.bed' in path:
        print(path)
        label = path.split('.bed')[0]
