geom_segment(aes(x=1, xend=1, y=-log10(0.05), yend=20), linetype=2) +
geom_segment(aes(x=-6, xend=-1, y=-log10(0.05), yend=-log10(0.05)), linetype=2) +
geom_segment(aes(x=1, xend=6, y=-log10(0.05), yend=-log10(0.05)), linetype=2) +
xlim(-6, 6)
