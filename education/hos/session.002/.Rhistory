# Load library
library(ggplot2)
# Read data
data <- read.table("volcano_data.tsv", header = TRUE, sep = "\t")
# Basic volcano plot
ggplot(data, aes(x = log2FoldChange, y = -log10(pvalue))) +
geom_point(alpha = 0.6) +
theme_minimal() +
labs(x = "log2(Fold Change)", y = "-log10(p-value)")
View(data)
# Basic volcano plot
ggplot(data, aes(x = estimate, y = -log10(qval))) +
geom_point(alpha = 0.6) +
theme_minimal() +
labs(x = "log2(Fold Change)", y = "-log10(p-value)")
